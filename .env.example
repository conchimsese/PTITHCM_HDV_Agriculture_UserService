# Copy to .env for local only. Fill blanks; no real secrets in this file.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081
# Persistent directory outside the webroot; back up together with user_db.
MEDIA_STORAGE_DIR=./local-data/media
DB_URL=jdbc:postgresql://localhost:5432/user_db
DB_PORT=5432
DB_USERNAME=user_app
DB_PASSWORD=
# Distinct random values, >=32 bytes, shared only with corresponding caller.
# Blank disables that caller. This phase permits only GET access-state.
INTERNAL_GATEWAY_KEY=
INTERNAL_FARMING_KEY=
INTERNAL_TRADING_KEY=
INTERNAL_CHAT_KEY=
INTERNAL_PAYMENT_KEY=
INTERNAL_NOTIFICATION_KEY=

# java scripts/GenerateLocalAuth.java fills only missing/blank local secrets in .env.
AUTH_ENABLED=true
OTP_HMAC_SECRET=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_KEY_ID=
# Deploy the previous public key alongside the current one for at least 16 minutes.
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY_PATH=
# Local profile defaults to Mailpit localhost:1025; production needs explicit SMTP.
# MAIL_FROM=your-verified-sender
# MAIL_HOST=your-smtp-server
# MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# Enable before integration/demo; configure two distinct real identities/passwords.
ADMIN_SEED_ENABLED=false
ADMIN_1_USERNAME=
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_USERNAME=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
